{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dov-calc.local/schemas/page.schema.json",
  "title": "Fuxiao Wiki Page Frontmatter",
  "description": "Metadata required for publishable Fuxiao Wiki Markdown pages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "section",
    "order",
    "audience",
    "contentType",
    "gameVersion",
    "sourceUpdatedAt",
    "verifiedAt",
    "status",
    "authors",
    "reviewers",
    "sources",
    "tags",
    "related"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 96,
      "description": "Stable site-wide page ID. Publishing checks must enforce uniqueness across pages."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 12,
      "maxLength": 240
    },
    "section": {
      "type": "string",
      "enum": [
        "home",
        "start",
        "progression",
        "combat",
        "mechanics",
        "topics",
        "data",
        "tools",
        "about"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "new-player",
          "beginner",
          "regular",
          "advanced",
          "editor",
          "maintainer"
        ]
      }
    },
    "contentType": {
      "type": "string",
      "enum": [
        "guide",
        "mechanic",
        "data",
        "topic",
        "tool",
        "news",
        "changelog",
        "site"
      ]
    },
    "gameVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(?:-[a-z0-9]+)?$",
      "description": "Game baseline version for the page conclusion, for example 2026-07."
    },
    "sourceUpdatedAt": {
      "type": "string",
      "format": "date"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "current",
        "stale",
        "archived"
      ]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pageSource"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "sourceType",
        "permission",
        "publicUse"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "official",
            "wiki",
            "author-post",
            "forum",
            "video",
            "docx",
            "xlsx",
            "image",
            "dataset",
            "internal"
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date"
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "author": {
          "type": "string",
          "maxLength": 80
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "publicUse": {
          "$ref": "#/$defs/publicUse"
        },
        "licenseEvidence": {
          "type": "string",
          "maxLength": 240
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "assetId"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "permission": {
                "enum": [
                  "pending",
                  "restricted"
                ]
              }
            },
            "required": [
              "permission"
            ]
          },
          "then": {
            "properties": {
              "publicUse": {
                "properties": {
                  "body": {
                    "const": false
                  },
                  "asset": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "permission": {
                "const": "quoted"
              }
            },
            "required": [
              "permission"
            ]
          },
          "then": {
            "properties": {
              "publicUse": {
                "properties": {
                  "body": {
                    "const": true
                  },
                  "asset": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "permission": {
      "type": "string",
      "enum": [
        "owned",
        "authorized",
        "quoted",
        "pending",
        "restricted"
      ]
    },
    "publicUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "asset"
      ],
      "properties": {
        "body": {
          "type": "boolean",
          "description": "Whether source-derived body text may enter public pages."
        },
        "asset": {
          "type": "boolean",
          "description": "Whether source assets may enter public build artifacts."
        },
        "quoteOnly": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
