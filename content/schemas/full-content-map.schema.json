{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dov-calc.local/schemas/full-content-map.schema.json",
  "title": "Fuxiao Wiki Full Content Migration Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schema",
    "generatedAt",
    "generationPolicy",
    "assets",
    "elements",
    "drawingRelations",
    "dataRecords",
    "sourceSummaries",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "schema": {
      "const": "../schemas/full-content-map.schema.json"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generationPolicy": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 29,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "drawingRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drawingRelation"
      }
    },
    "dataRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataRecord"
      }
    },
    "sourceSummaries": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    }
  },
  "$defs": {
    "sourceAssetId": {
      "type": "string",
      "pattern": "^src-[a-f0-9]{12}$"
    },
    "sourceElementId": {
      "type": "string",
      "pattern": "^src-[a-f0-9]{12}:(paragraph|heading|table|media|formula|worksheet|image):[a-f0-9]{16}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "published",
        "merged",
        "internal-only",
        "omitted-with-rationale"
      ]
    },
    "paragraphPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "bodyIndex",
        "paragraphIndex"
      ],
      "properties": {
        "part": {
          "const": "word/document.xml"
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 1
        },
        "paragraphIndex": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tablePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "bodyIndex",
        "tableIndex"
      ],
      "properties": {
        "part": {
          "const": "word/document.xml"
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 1
        },
        "tableIndex": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mediaPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagePath",
        "mediaIndex"
      ],
      "properties": {
        "packagePath": {
          "type": "string",
          "pattern": "^word/media/"
        },
        "mediaIndex": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "formulaPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "bodyIndex",
        "formulaIndex",
        "ooxmlKind"
      ],
      "properties": {
        "part": {
          "const": "word/document.xml"
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 1
        },
        "formulaIndex": {
          "type": "integer",
          "minimum": 1
        },
        "ooxmlKind": {
          "enum": [
            "m:oMath",
            "m:oMathPara"
          ]
        }
      }
    },
    "drawingPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "bodyIndex",
        "drawingIndex"
      ],
      "properties": {
        "part": {
          "const": "word/document.xml"
        },
        "bodyIndex": {
          "type": "integer",
          "minimum": 1
        },
        "drawingIndex": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "worksheetPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worksheet"
      ],
      "properties": {
        "worksheet": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imagePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceFile"
      ],
      "properties": {
        "sourceFile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAssetId",
        "assetType",
        "sourcePath",
        "sourceSha256",
        "permission",
        "authorizationEvidenceId",
        "publicRelease",
        "disposition"
      ],
      "properties": {
        "sourceAssetId": {
          "$ref": "#/$defs/sourceAssetId"
        },
        "assetType": {
          "enum": [
            "docx",
            "xlsx",
            "image"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "permission": {
          "enum": [
            "owned",
            "authorized",
            "quoted",
            "pending",
            "restricted"
          ]
        },
        "authorizationEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "publicRelease": {
          "type": "object"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceAssetId",
        "sourceElementId",
        "elementType",
        "sourcePosition",
        "targetPageIds",
        "targetAssetIds",
        "disposition",
        "authorizationEvidenceId",
        "editor",
        "factReviewer",
        "status",
        "notes"
      ],
      "properties": {
        "sourceAssetId": {
          "$ref": "#/$defs/sourceAssetId"
        },
        "sourceElementId": {
          "$ref": "#/$defs/sourceElementId"
        },
        "elementType": {
          "enum": [
            "paragraph",
            "heading",
            "table",
            "media",
            "formula",
            "worksheet",
            "image"
          ]
        },
        "sourcePosition": {
          "type": "object"
        },
        "paragraphStyleId": {
          "type": "string"
        },
        "paragraphSemantic": {
          "enum": [
            "prose",
            "non-prose"
          ]
        },
        "targetPageIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetAssetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authorizationEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "factReviewer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "elementType": {
                "enum": [
                  "paragraph",
                  "heading"
                ]
              }
            }
          },
          "then": {
            "required": [
              "paragraphStyleId"
            ],
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/paragraphPosition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "paragraph"
              }
            }
          },
          "then": {
            "required": [
              "paragraphSemantic"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "table"
              }
            }
          },
          "then": {
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/tablePosition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "media"
              }
            }
          },
          "then": {
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/mediaPosition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "formula"
              }
            }
          },
          "then": {
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/formulaPosition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "worksheet"
              }
            }
          },
          "then": {
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/worksheetPosition"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "elementType": {
                "const": "image"
              }
            }
          },
          "then": {
            "properties": {
              "sourcePosition": {
                "$ref": "#/$defs/imagePosition"
              }
            }
          }
        }
      ]
    },
    "tableCellPathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableIndex",
        "tableSourceElementId",
        "rowIndex",
        "cellIndex",
        "gridColumn",
        "gridSpan",
        "verticalMerge"
      ],
      "properties": {
        "tableIndex": { "type": "integer", "minimum": 1 },
        "tableSourceElementId": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{12}:table:[a-f0-9]{16}$"
        },
        "rowIndex": { "type": "integer", "minimum": 1 },
        "cellIndex": { "type": "integer", "minimum": 1 },
        "gridColumn": { "type": "integer", "minimum": 1 },
        "gridSpan": { "type": "integer", "minimum": 1 },
        "verticalMerge": { "enum": ["restart", "continue", null] }
      }
    },
    "tableCellPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellPlacementId",
        "tableIndex",
        "tableSourceElementId",
        "rowIndex",
        "cellIndex",
        "gridColumn",
        "gridSpan",
        "rowSpan",
        "verticalMerge",
        "paragraphIndex",
        "runIndex",
        "drawingIndexInParagraph",
        "drawingIndexInCell",
        "cellContentOrdinal",
        "cellPath"
      ],
      "properties": {
        "cellPlacementId": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{12}:placement:[a-f0-9]{16}$"
        },
        "tableIndex": { "type": "integer", "minimum": 1 },
        "tableSourceElementId": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{12}:table:[a-f0-9]{16}$"
        },
        "rowIndex": { "type": "integer", "minimum": 1 },
        "cellIndex": { "type": "integer", "minimum": 1 },
        "gridColumn": { "type": "integer", "minimum": 1 },
        "gridSpan": { "type": "integer", "minimum": 1 },
        "rowSpan": { "type": "integer", "minimum": 0 },
        "verticalMerge": { "enum": ["restart", "continue", null] },
        "paragraphIndex": { "type": "integer", "minimum": 0 },
        "runIndex": { "type": "integer", "minimum": 0 },
        "drawingIndexInParagraph": { "type": "integer", "minimum": 0 },
        "drawingIndexInCell": { "type": "integer", "minimum": 1 },
        "cellContentOrdinal": { "type": "integer", "minimum": 1 },
        "cellPath": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tableCellPathEntry" }
        }
      }
    },
    "drawingRelation": {
      "type": "object",
      "required": [
        "sourceAssetId",
        "sourceRelationId",
        "sourcePosition",
        "resolution",
        "disposition",
        "reason",
        "targetPageIds",
        "authorizationEvidenceId",
        "editor",
        "factReviewer",
        "status",
        "notes"
      ],
      "properties": {
        "sourceAssetId": {
          "$ref": "#/$defs/sourceAssetId"
        },
        "sourceRelationId": {
          "type": "string",
          "pattern": "^src-[a-f0-9]{12}:relation:[a-f0-9]{16}$"
        },
        "sourcePosition": {
          "$ref": "#/$defs/drawingPosition"
        },
        "targetMediaElementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tableCell": {
          "$ref": "#/$defs/tableCellPlacement"
        },
        "placement": {
          "type": "object",
          "properties": {
            "slot": {
              "enum": [
                "inline-after-anchor",
                "float-after-anchor",
                "source-header",
                "source-footer",
                "table-cell"
              ]
            },
            "tableCell": {
              "$ref": "#/$defs/tableCellPlacement"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "slot": { "const": "table-cell" } },
                "required": ["slot"]
              },
              "then": { "required": ["tableCell"] }
            }
          ]
        },
        "resolution": {
          "enum": [
            "media",
            "layout",
            "non-media-relationship"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "targetPageIds": {
          "type": "array"
        },
        "authorizationEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "editor": {
          "type": "string",
          "minLength": 1
        },
        "factReviewer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAssetId",
        "sourceElementId",
        "recordId",
        "worksheet",
        "worksheetRow",
        "disposition",
        "reason",
        "targetAssetIds",
        "authorizationEvidenceId",
        "status"
      ],
      "properties": {
        "sourceAssetId": {
          "$ref": "#/$defs/sourceAssetId"
        },
        "sourceElementId": {
          "$ref": "#/$defs/sourceElementId"
        },
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "worksheet": {
          "type": "string",
          "minLength": 1
        },
        "worksheetRow": {
          "type": "integer",
          "minimum": 1
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "targetAssetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "authorizationEvidenceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
