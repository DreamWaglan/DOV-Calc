{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dov-calc.local/schemas/data-record.schema.json",
  "title": "Fuxiao Wiki Data Record",
  "description": "Schema for versioned structured data records imported from canonical files or curated manually.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "values",
    "applicableVersion",
    "verifiedAt",
    "sourceRefs",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 120,
      "description": "Stable record ID. Dataset-level validation must enforce uniqueness."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "applicableVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(?:-[a-z0-9]+)?$"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "IDs from the source asset ledger or page source registry."
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "archived"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "recordCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(?:-[a-z0-9]+)?$"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "importedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceFileHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldDefinition"
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromVersion",
        "note"
      ],
      "properties": {
        "fromVersion": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(?:-[a-z0-9]+)?$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "archivedRecordId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  },
  "$defs": {
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "nullable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "nullable": {
          "type": "boolean"
        },
        "nullMeaning": {
          "type": "string",
          "maxLength": 160
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "description": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
